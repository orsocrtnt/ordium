{
  "name": "ordium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "ordium": "pnpm --filter @ordium/cli run ordium",
    "dev": "pnpm run --parallel --filter @ordium/api --filter @ordium/web dev",
    "dev:api": "pnpm --filter @ordium/api dev",
    "dev:web": "pnpm --filter @ordium/web dev"
  }
}
