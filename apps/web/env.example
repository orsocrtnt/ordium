# Ordium Web — variables d'environnement
# Copiez vers .env.local : cp env.example .env.local

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Compte démo (fallback local)
NEXT_PUBLIC_DEMO_EMAIL=demo@ordium.app
NEXT_PUBLIC_DEMO_PASSWORD=demo1234

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth e-mail (dashboard Supabase) :
# 1. Authentication → URL Configuration
#    - Site URL : http://localhost:3000 (prod = ton domaine)
#    - Redirect URLs : http://localhost:3000/auth/callback (+ URL prod /auth/callback)
# 2. Authentication → Providers → Email : activer « Confirm email »
# 3. Authentication → Policies / Password : min 10 caractères, majuscule, minuscule, chiffre, symbole
#    (aligné avec apps/web/src/lib/passwordPolicy.ts)

# --- OAuth (optionnel) ---
# Alpaca : OAuth App → redirect http://localhost:3000/api/oauth/alpaca/callback
NEXT_PUBLIC_ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=

# Coinbase OAuth : partenaires CDP uniquement — sinon guide clé API
# Redirect : http://localhost:3000/api/oauth/coinbase/callback
NEXT_PUBLIC_COINBASE_OAUTH_CLIENT_ID=
COINBASE_OAUTH_CLIENT_ID=
COINBASE_OAUTH_CLIENT_SECRET=
