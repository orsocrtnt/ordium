# OAuth Ordium — variables à coller dans apps/web/.env.local
#
# ─── Alpaca (recommandé, créable par vous) ───
# 1. Compte : https://app.alpaca.markets/signup
# 2. Créer une OAuth application (Broker / OAuth Apps dans le dashboard développeur)
# 3. Redirect URI exacte :
#      http://localhost:3000/api/oauth/alpaca/callback
# 4. Coller Client ID + Secret ci-dessous (et redémarrer `pnpm dev`)

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=

# ─── Coinbase (partenaires uniquement) ───
# La création d’apps OAuth Coinbase est limitée aux partenaires CDP approuvés.
# Sans ça → utilisez le tutoriel clé API CDP dans l’UI Ordium.
# Si vous avez une app partenaire :
# Redirect : http://localhost:3000/api/oauth/coinbase/callback

NEXT_PUBLIC_COINBASE_OAUTH_CLIENT_ID=
COINBASE_OAUTH_CLIENT_ID=
COINBASE_OAUTH_CLIENT_SECRET=

# Binance / Kraken / Trading 212 / IBKR → pas d’OAuth public → guide clé API dans l’UI
