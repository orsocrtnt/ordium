# Copiez ce fichier vers apps/api/.env et collez votre clé :
#   cp apps/api/env.example apps/api/.env
#
# Obtenir une clé : https://aistudio.google.com/apikey

GEMINI_API_KEY=
# Modèle vision (défaut : gemini-3.5-flash-lite, avec fallback auto)
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Market data (APIs officielles) ---
# Crypto (sans clé) : Binance → Coinbase → Kraken
#
# Actions / ETF US (recommandé, gratuit) — https://app.alpaca.markets/signup
# Créer des clés Paper Trading, puis :
ALPACA_API_KEY=
ALPACA_API_SECRET=
#
# Optionnel US (Polygon) : POLYGON_API_KEY=
# Secours EU (MC.PA, IWDA.AS…) : Yahoo Finance — sans clé, déjà intégré
#
# Interactive Brokers : pas au MVP (Gateway TWS lourde) — plus tard si besoin

# --- Exécution (vault credentials Alpaca / Binance) ---
# Clé maître AES-256 (64 hex ou passphrase). Sans ça : clé de dev locale.
# ORDIUM_VAULT_KEY=

API_PORT=4000
CORS_ORIGIN=http://localhost:3000
